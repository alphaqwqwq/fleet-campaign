{
  "name": "fleet-campaign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify:governance": "node scripts/verify-governance.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p api",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace @fleet-campaign/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@vercel/kv": "^3.0.0"
  }
}
